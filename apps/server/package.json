{
  "name": "@t3-orchestra/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --watch-preserve-output --import tsx src/index.ts",
    "build": "node scripts/build.mjs",
    "start": "node dist/index.js --open",
    "typecheck": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "spike": "tsx scripts/spike.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@t3-orchestra/shared": "workspace:*",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "execa": "^10.2.1",
    "hono": "^4.13.16",
    "mustache": "^4.2.0",
    "node-notifier": "^12.1.0",
    "open": "^11.0.4",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/mustache": "^4.2.6",
    "@types/node-notifier": "^8.0.5",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15"
  }
}
